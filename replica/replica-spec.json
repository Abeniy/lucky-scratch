{
  "$comment": "幸运刮刮乐 Roguelike 复刻规格（机器可读）。所有数值为运行时实测/源码提取的最终值，单位 px（自然尺寸，未缩放）或百分比字符串。缩放时整体乘 k。",
  "meta": {
    "title": "幸运刮刮乐 · Roguelike",
    "source": "web/index.html + web/style.css + web/game.js",
    "target": "platform-agnostic",
    "scope": ["ui", "interaction", "logic"],
    "companion": ["REPLICA_SPEC.md", "assets-manifest.json", "assets.zip"]
  },

  "tokens": {
    "colors": {
      "text": "#d8d4f0",
      "textDim": "#8983b5",
      "neonGold": "#ffd23c",
      "neonCyan": "#00f0ff",
      "neonLime": "#b6ff3c",
      "scoreValue": "#ffc42e",
      "statusbarBg": "rgba(255,250,236,0.92)",
      "statusbarBorder": "rgba(120,96,60,0.32)",
      "statusbarText": "#6b5335",
      "paperTitleDark": "#3a2c12",
      "paperTitleGold": "#4a3600",
      "overlayMask": "rgba(6,5,16,0.74)",
      "slotPriceText": "#0a0816",
      "slotPriceBg": "#ffd23c"
    },
    "fonts": {
      "stack": ["FZLTRegular", "FZLTHeavy", "PingFang SC", "Microsoft YaHei", "Segoe UI", "sans-serif"],
      "note": "FZLT* 为商业字体，复刻需确认授权，可用思源黑体/苹方替代"
    },
    "radius": { "statusbar": 8, "perkCard": 10, "perkTip": 8, "debugPanel": 12, "toolUnlockModal": 0, "levelBar": 14, "pricePill": 999 },
    "zIndex": { "perkOverlay": 50, "toolUnlockOverlay": 58, "topbar": 120, "statusbar": 120, "debug": 200, "cardInlineInfo": 2 }
  },

  "adaptive": {
    "hudBoundary": {
      "description": "顶栏三列栅格；两侧 1fr 同下限 → 等级条居中且与得分不重叠",
      "hudSide": "scoreControlWidth + 24",
      "hudSideMeasured": 173,
      "narrowBreakpoint": 720,
      "narrow": { "hudSideMin": 128, "scoreLabelFont": 20, "coinValueFont": 28 }
    },
    "stage": {
      "natural": { "w": 920, "h": 952 },
      "formulas": {
        "topOcc": "max(topbar.bottom, perkBar.bottom)",
        "botOcc": "vh - statusbar.top",
        "availH": "vh - topOcc - botOcc - 32",
        "reserve": "min(scaledToolsW + 50 + 24, vw * 0.28)",
        "availW": "vw - 2 * reserve",
        "k": "min(1, availH / 952, availW / 920)",
        "offsetY": "(topOcc - botOcc) / 2",
        "transform": "translateY(offsetY) scale(k)",
        "transformOrigin": "center"
      },
      "reference": [
        { "viewport": [1600, 1000], "k": 0.84, "kTools": 1, "stageTopBottom": [131, 931], "toolsTopBottom": [230, 822], "gap": 286 },
        { "viewport": [1258, 900], "k": 0.735, "kTools": 1, "stageTopBottom": [130, 899], "toolsTopBottom": [180, 772], "gap": 157 },
        { "viewport": [1258, 700], "k": 0.525, "kTools": 0.845, "stageTopBottom": [126, 626], "toolsTopBottom": [126, 626], "gap": 251 },
        { "viewport": [900, 600], "k": 0.42, "kTools": 0.372, "stageTopBottom": [126, 526], "toolsTopBottom": [126, 346], "gap": 220 },
        { "viewport": [640, 480], "k": 0.294, "kTools": 0.473, "stageTopBottom": [128, 406], "toolsTopBottom": [126, 406], "gap": 58 }
      ]
    },
    "tools": {
      "natural": { "w": 128, "h": 592 },
      "right": 50,
      "formulas": {
        "k": "min(1, availH / 592, (vw * 0.28) / 128)",
        "top": "safeCenter - 592 / 2",
        "safeCenter": "(topOcc + (vh - botOcc)) / 2"
      }
    }
  },

  "elements": {
    "topbar": { "pos": "fixed", "x": 20, "y": 18, "w": "vw-40", "h": 56, "layout": "grid 3 cols: [1fr>=hudSide][980][1fr>=hudSide]", "z": 120 },
